# Copy this file to ".env" (same folder, project root) and fill in your key.
# .env is git-ignored — your real key never gets committed.
# The scraper (data/scripts/scraper/) loads this automatically.

# Required: Gemini API key for image verification.
# Get one free at https://aistudio.google.com  (Get API key)
GEMINI_API_KEY=AIza-your-key-here

# Optional: override the verifier model (default is gemini-2.5-flash).
# SCRAPER_VERIFY_MODEL=gemini-2.5-pro

# Optional: enable the Reddit harvest source.
# REDDIT_CLIENT_ID=your-client-id
# REDDIT_CLIENT_SECRET=your-client-secret
